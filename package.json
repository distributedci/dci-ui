    "vitest": "^4.1.10"
  },
  "scripts": {
    "build": "node --version && vite build",
    "lint": "eslint --no-color",
    "postbuild": "rm build/mockServiceWorker.js",
    "prettier": "prettier --write src",
    "preview": "vite preview",
    "start": "vite --port 8000",
    "test": "npm run lint && npm run typecheck && NO_COLOR=true LANG=en_US.UTF-8 TZ=UTC vitest run",
    "test:watch": "LANG=en_US.UTF-8 TZ=UTC vitest watch",
    "typecheck": "tsc -p tsconfig.app.json --noEmit --pretty false"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "msw": {
    "workerDirectory": "public"
  }
}
